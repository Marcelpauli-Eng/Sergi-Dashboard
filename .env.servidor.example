# Plantilla del .env de un cliente en el servidor de programas.
# `servidor.sh alta` la copia a clientes/<cliente>/.env y rellena @cliente@,
# @aleatoria@ y @carpeta-cliente@. Lo demás lo rellenas tú: es de cada cliente.
INSTANCIA=@cliente@
ENV_CLIENTE=@carpeta-cliente@/.env
# El túnel entra por aquí (Next.js escucha en el 3000).
PUERTO_INTERNO=3000
LIMITE_RAM_WEB=512m

# ─── Google (docs/GOOGLE-SETUP.md) ─────────────────────────────────────────
# Cada cliente con su cuenta de servicio y sus documentos.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# En UNA sola línea, entre comillas dobles y con los \n tal cual vienen en el JSON.
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_ID_FACTURAS=""
GOOGLE_MAPS_API_KEY=""

# ─── Negocio ──────────────────────────────────────────────────────────────
DEPOT_ADDRESS=""
BUSINESS_TIMEZONE="Europe/Madrid"

# ─── Acceso ───────────────────────────────────────────────────────────────
SESSION_SECRET=@aleatoria@
# Transportistas: codigo:pin:nombre, separados por comas.
DRIVERS=""

# El panel de operaciones lee /api/diagnostic con esta clave (solo eso).
PANEL_CLAVE=@aleatoria@
DIAGNOSTICO=/api/diagnostic

# Para enseñarlo antes de tener sus datos: pedidos de ejemplo, se entra con
# demo / 1234. Quítalo en cuanto el cliente tenga su Google Sheet.
DEMO_MODE="true"
