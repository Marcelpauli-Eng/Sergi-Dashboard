# Copia este archivo a .env.local y rellénalo:
#
#     cp .env.example .env.local
#
# .env.local NUNCA se sube al repositorio: son credenciales.
# En producción estas mismas variables se configuran en Vercel, y allí
# los valores van SIN comillas.


# ─── Google ───────────────────────────────────────────────────────────────
# Guía paso a paso para conseguirlos: docs/GOOGLE-SETUP.md
#
# Atajo: con el JSON de la cuenta de servicio ya descargado,
#
#     npm run env:json -- ~/Downloads/tu-proyecto-a1b2c3.json
#
# te imprime las dos primeras líneas ya formateadas, más SESSION_SECRET.

GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# ⚠️ En UNA sola línea, entre comillas dobles y con los \n LITERALES, tal y
# como vienen en el JSON. Pegar saltos de línea reales es el fallo número uno
# y da un `invalid_grant` que no explica nada.
GOOGLE_PRIVATE_KEY=""

# El trozo de la URL del Sheet entre /d/ y /edit. También vale pegar la URL
# entera: la app le saca el ID.
GOOGLE_SHEET_ID=""

# OPCIONAL. Sin definir, la app busca sola la pestaña del mes en curso entre
# las que tenga el documento ("Agost 2026", "08/2026", "ago-26"…).
# Defínela solo para forzar una pestaña concreta.
# GOOGLE_SHEET_TAB=""

# OBLIGATORIA para poder facturar. Documento donde se registran las facturas
# emitidas (pestaña "Factures"). Sin ella el resto de la app funciona, pero
# la pantalla de Factures dice que falta esta variable.
#
# El de arriba lo comparte la empresa: lo necesita, es su hoja de pedidos. Y
# Google Sheets NO sabe ocultar una pestaña a quien tiene acceso al
# documento — esconderla es cosmético y la protección de hojas limita la
# edición, no la lectura. Lo que factura el transportista no es asunto de la
# empresa, así que se pone aquí un documento aparte, compartido solo con el
# email de la cuenta de servicio (con permiso de Editor).
#
# Guarda DOS pestañas: "Factures" (las facturas emitidas) e "Imports" (lo que
# se cobra por cada comanda). Ninguna de las dos puede estar en la hoja de
# repartos: esa la ve la empresa entera.
#
# OJO al cambiarla con facturas ya emitidas: la serie se calcula a partir de
# la última que haya en ESTE documento. O copias la pestaña "Factures" al
# nuevo, o pones en Ajustes → Facturació un "primer número" por encima de la
# última emitida. Si no, se repetirían números.
#
# Y para mudar los importes que ya estén en la columna "Import" de la hoja de
# repartos:  npm run migrar:imports
GOOGLE_SHEET_ID_FACTURAS=""

# Clave de API restringida a Geocoding API + Routes API.
GOOGLE_MAPS_API_KEY=""


# ─── Negocio ──────────────────────────────────────────────────────────────

# Punto de partida de todas las rutas.
DEPOT_ADDRESS=""

# Determina qué se considera "hoy". Opcional, por defecto Europe/Madrid.
# BUSINESS_TIMEZONE="Europe/Madrid"


# ─── Acceso ───────────────────────────────────────────────────────────────

# Mínimo 32 caracteres aleatorios. Firma la cookie de sesión.
SESSION_SECRET=""

# Transportistas dados de alta: codigo:pin:nombre, separados por comas.
# El PIN te lo inventas tú.
#
# Si la hoja tiene columna "Transportista", el código debe coincidir con lo
# que ponga en ella. Si no la tiene, hay un solo transportista y verá todos
# los pedidos del día.
DRIVERS="sergi:4821:Sergi Pons"


# ─── Demo ─────────────────────────────────────────────────────────────────
# Descomenta para ver la interfaz con pedidos de ejemplo, sin tocar Google.
# Se entra con demo / 1234. NO la pongas en producción.
# DEMO_MODE="true"
